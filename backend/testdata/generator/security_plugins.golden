# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 2400:cb00::/32 203.0.113.0/24
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
	metrics {
		per_host
	}
	crowdsec {
		api_url http://crowdsec:8080
		api_key {file./run/caddyhub/secrets/crowdsec-api_key}
		ticker_interval 15s
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 1: API
api.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	route {
		crowdsec
		rate_limit {
			zone site_1 {
				key {client_ip}
				events 100
				window 1m
			}
		}
		reverse_proxy api:3000
	}
}

# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 3: Deep
a.b.example.com {
	tls {
		issuer acme {
			dir https://acme-staging-v02.api.letsencrypt.org/directory
			email admin@example.com
			disable_http_challenge
			disable_tlsalpn_challenge
			dns cloudflare {
				api_token {file./run/caddyhub/secrets/dns-1-api_token}
			}
			resolvers 9.9.9.9 149.112.112.112
			propagation_timeout 5m
		}
	}
	log {
		output file /var/log/caddy/access-site-3.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy deep:80
	}
}

# site 4: Net
www.example.net {
	tls {
		issuer acme {
			dir https://acme-staging-v02.api.letsencrypt.org/directory
			email admin@example.com
			disable_http_challenge
			disable_tlsalpn_challenge
			dns porkbun {
				api_key {env.PORKBUN_API_KEY}
				api_secret_key {file./run/caddyhub/secrets/dns-2-api_secret_key}
			}
			resolvers 1.1.1.1
			propagation_timeout 5m
		}
	}
	log {
		output file /var/log/caddy/access-site-4.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy net:80
	}
}

# site 5: Org

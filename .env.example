# Copy to .env and adjust. Everything is optional.

# Encrypts DNS credentials and other secrets in the database. If unset, a key
# is generated in the panel's data volume; set it explicitly so a backup can
# be restored on another host. Generate one with: openssl rand -base64 32
CADDYHUB_SECRET_KEY=

# Require this token to create the first admin account (recommended if the
# panel port is reachable by others before you finish setup).
CADDYHUB_SETUP_TOKEN=

# Or create the admin account unattended on first start.
CADDYHUB_INITIAL_ADMIN_USER=
CADDYHUB_INITIAL_ADMIN_PASSWORD=

# Host port for the panel UI.
CADDYHUB_PORT=8080

# Public URL of the panel if you serve it over HTTPS (enables Secure cookies).
CADDYHUB_BASE_URL=

# Set to true when the panel itself is served through Caddy (Settings ->
# "Serve CaddyHub itself at"), so client IPs come from X-Forwarded-For.
CADDYHUB_TRUST_PROXY_HEADERS=false

# Caddy build: version tag of the official caddy image and the plugins to
# compile in (space separated). Rebuild after changing: docker compose build caddy
CADDY_VERSION=2
CADDY_PLUGINS=github.com/caddy-dns/cloudflare github.com/mholt/caddy-ratelimit

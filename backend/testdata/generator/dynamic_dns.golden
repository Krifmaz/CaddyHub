# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	dynamic_dns {
		provider cloudflare {
			api_token {file./run/caddyhub/secrets/dns-1-api_token}
		}
		domains {
			example.com @ www
			example.net home
		}
		ip_source upnp
		ip_source simple_http https://icanhazip.com
		check_interval 5m
		versions ipv4
		ttl 1h
		update_only
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 1: Home
home.example.net {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	reverse_proxy home:80
}

			dir https://acme-staging-v02.api.letsencrypt.org/directory
			email admin@example.com
			disable_tlsalpn_challenge
		}
	}
	log {
		output file /var/log/caddy/access-site-5.log {
			roll_size 10MiB
			roll_keep 5

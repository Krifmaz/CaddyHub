# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	crowdsec {
		api_url http://127.0.0.1:8081
		api_key {file./run/caddyhub/secrets/crowdsec-api_key}
		ticker_interval 15s
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# Caddymium: blocked crawlers and AI scrapers (Security page)
(cp_bots) {
	@cp_bot {
		header_regexp User-Agent `(?i)(?:AdsBot-Google|AhrefsBot|AhrefsSiteAudit|BLEXBot|Baiduspider|Barkrowler|BingPreview|BitSightBot|Brightbot 1\.0|CensysInspect|ClaudeBot|DataForSeoBot|Discordbot|DotBot|DuckDuckBot|DuckDuckGo-Favicons-Bot|Embedly|Exabot|Expanse|GPTBot|Google-InspectionTool|Googlebot|Iframely|InternetMeasurement|LinkedInBot|MJ12bot|Mediapartners-Google|MegaIndex|MojeekBot|Naverbot|Nuclei|Pinterestbot|Qwantbot|Qwantify|SEOkicks|Screaming Frog|Seekport|SeekportBot|SemrushBot|SeznamBot|SiteAuditBot|SkypeUriPreview|Slackbot|Slurp|Sogou|Storebot-Google|TelegramBot|Turnitin|Twitterbot|Wayback Machine|WhatsApp|YandexBot|YandexImages|Yeti|ZoominfoBot|adidxbot|archive\.org_bot|bigsur\.ai|bingbot|coccocbot|heritrix|ia_archiver|linkdexbot|masscan|msnbot|redditbot|rogerbot|serpstatbot|zgrab)`
		not header_regexp User-Agent `(?i)(?:Uptime-Kuma)`
	}
	respond @cp_bot Forbidden 403
}

# site 1: Vault
vault.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		crowdsec
		import cp_bots
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		@cp_rate_limited not client_ip 10.0.1.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48
		rate_limit @cp_rate_limited {
			zone site_1 {
				key {client_ip}
				events 300
				window 1m
			}
		}
		request_header -Remote-User
		request_header -Remote-Name
		request_header -Remote-Email
		request_header -Remote-Groups
		@cp_login not path /api/* /identity/* /notifications/* /icons/* /attachments/* /events/* *-connector.html /app-id.json /.well-known/*
		forward_auth @cp_login panel:8080 {
			uri /api/sso/verify?site=1
			copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
		}
		reverse_proxy app:8080
	}
}

# site 2: Admin
admin.example.com {
	log {
		output file /var/log/caddy/access-site-2.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		crowdsec
		import cp_bots
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		@cp_not_allowed not client_ip 10.0.1.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48
		respond @cp_not_allowed "This site is only available from home." 403
		reverse_proxy app:8080
	}
}

# site 3: Media
media.example.com {
	log {
		output file /var/log/caddy/access-site-3.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		crowdsec
		import cp_bots
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		@cp_rate_limited not client_ip 10.0.1.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48
		rate_limit @cp_rate_limited {
			zone site_3 {
				key {client_ip}
				events 300
				window 1m
			}
		}
		@cp_login path /web /web/*
		basic_auth @cp_login {
			family $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
		}
		reverse_proxy app:8080
	}
}

# site 4: Open
open.example.com {
	log {
		output file /var/log/caddy/access-site-4.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	reverse_proxy app:8080
}

# Caddymium sign-in page
auth.example.com {
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		crowdsec
		import cp_bots
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		redir / /sso/login 302
		reverse_proxy /sso/* panel:8080
		respond "Not found" 404
	}
}

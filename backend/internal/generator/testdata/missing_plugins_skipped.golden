# Generated by CaddyHub. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 1: API
api.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	route {
		reverse_proxy api:3000
	}
}

# --- warnings ---
# domain example.com: DNS-01 unavailable (missing credential or DNS provider plugin); falling back to HTTP/TLS-ALPN challenges and no wildcard
# site 1: rate limiting requested but caddy-ratelimit is not installed; skipped

		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy both:80
	}
}

# site 5: ToWWW
www.example.com {
	log {
		output file /var/log/caddy/access-site-5.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy web:80
	}
}

# site 5: www redirect
example.com {
	redir https://www.example.com{uri} permanent
}

# site 6: ToApex
example.net, www.example.org {
	log {
		output file /var/log/caddy/access-site-6.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy web2:80
	}
}

# site 6: www redirect
www.example.net {
	redir https://example.net{uri} permanent
}

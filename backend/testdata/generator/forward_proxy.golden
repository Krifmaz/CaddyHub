# Generated by CaddyHub. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 1: Proxy
proxy.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	route {
		@cp_not_allowed not client_ip 192.168.0.0/16
		respond @cp_not_allowed Forbidden 403
		forward_proxy {
			basic_auth alice "s3cret pass"
			ports 80 443
			hide_ip
			hide_via
			probe_resistance secret.localhost
			dial_timeout 30s
			acl {
				deny 10.0.0.0/8
				allow all
			}
		}
	}
}

# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 1: Internal
nas.home.arpa {
	tls internal
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy nas:5000
	}
}

# site 2: Custom
secure.example.com {
	tls /certs/secure.crt /certs/secure.key
	log {
		output file /var/log/caddy/access-site-2.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy secure:443 {
			transport http {
				tls
				tls_insecure_skip_verify
			}
		}
	}
}

# site 3: Plain
http://plain.example.com {
	log {
		output file /var/log/caddy/access-site-3.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		reverse_proxy plain:80
	}
}


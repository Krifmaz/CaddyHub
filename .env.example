# Copy to .env and adjust. Everything is optional.

# Encrypts DNS credentials and other secrets in the database. If unset, a key
# is generated in the panel's data volume; set it explicitly so a backup can
# be restored on another host. Generate one with: openssl rand -base64 32
CADDYMIUM_SECRET_KEY=

# Require this token to create the first admin account (recommended if the
# panel port is reachable by others before you finish setup).
CADDYMIUM_SETUP_TOKEN=

# Or create the admin account unattended on first start.
CADDYMIUM_INITIAL_ADMIN_USER=
CADDYMIUM_INITIAL_ADMIN_PASSWORD=

# Host port for the panel UI.
CADDYMIUM_PORT=8080

# Public URL of the panel if you serve it over HTTPS (enables Secure cookies).
CADDYMIUM_BASE_URL=

# Set to true when the panel itself is served through Caddy (Settings ->
# "Serve Caddymium itself at"), so client IPs come from X-Forwarded-For.
CADDYMIUM_TRUST_PROXY_HEADERS=false

# Caddy build: version tag of the official caddy image and the plugins to
# compile in (space separated). The default includes Cloudflare, Porkbun,
# DuckDNS, Namecheap, Route53, DigitalOcean, Hetzner, deSEC, OVH, Gandi,
# ACME-DNS and rate limiting. Rebuild after changing: docker compose build caddy
CADDY_VERSION=2
# CADDY_PLUGINS=github.com/caddy-dns/cloudflare github.com/mholt/caddy-ratelimit

# Plugin manager: CPU architecture of the Caddy container as the download
# service names it (amd64, arm64). Detected from the running Caddy by default.
# CADDYMIUM_CADDY_ARCH=amd64

# Optional GitHub token: raises the API rate limit for "update available"
# checks of new Caddy releases.
# CADDYMIUM_GITHUB_TOKEN=

# Layout. The default image runs Caddy inside the panel container
# (all in one). Set to false for the two-container layout
# (docker-compose.split.yml), where Caddy runs from its own image.
# CADDYMIUM_MANAGE_CADDY=true

# Generated by CaddyHub. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 2: Files
files.example.com {
	log {
		output file /var/log/caddy/access-site-2.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	root * /srv/files
	file_server browse
}

# site 1: Docs
docs.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	root * /srv/docs
	try_files {path} /index.html
	file_server
}

# site 3: Old
old.example.com {
	log {
		output file /var/log/caddy/access-site-3.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	redir https://new.example.com{uri} 308
}

# site 4: Status
status.example.com {
	log {
		output file /var/log/caddy/access-site-4.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	header Content-Type application/json
	respond `{"ok":true}` 200
}

# site 5: Maint
maint.example.com {
	log {
		output file /var/log/caddy/access-site-5.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	route {
		header Retry-After 300
		respond "Down for maintenance. Please check back soon." 503
	}
}

# Generated by Caddymium. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}

# site 7: Proxmox
pve.example.com {
	log {
		output file /var/log/caddy/access-site-7.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options SAMEORIGIN
		-Server
		-X-Powered-By
	}
	header {
		-Server
		?Referrer-Policy same-origin
		?X-Content-Type-Options nosniff
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
	}
	request_body {
		max_size 100MB
	}
	route {
		respond /robots.txt <<ROBOTS
		User-agent: *
		Disallow: /
		ROBOTS 200
		@cp_denied client_ip 192.168.66.0/24
		respond @cp_denied Forbidden 403
		@cp_not_allowed not client_ip 192.168.0.0/16 10.0.0.0/8
		respond @cp_not_allowed Forbidden 403
		basic_auth {
			admin $2a$14$Zkx19XLiW6VYouLHR5NmfOFU0z2GTNmpkT/5qqR7hx4IjWJPDhjvG
		}
		handle_path /grpc/* {
			reverse_proxy grpc:50051 {
				transport http {
					versions h2c 2
				}
			}
		}
		handle /old/* {
			redir https://new.example.com{uri} 301
		}
		handle {
			reverse_proxy https://10.0.0.10:8006 https://10.0.0.11:8006 {
				lb_policy least_conn
				lb_retries 2
				lb_try_duration 5s
				health_uri /
				health_interval 30s
				health_timeout 5s
				health_status 2xx
				fail_duration 30s
				max_fails 3
				unhealthy_status 5xx
				flush_interval -1
				header_up X-Real-IP {client_ip}
				transport http {
					dial_timeout 5s
					response_header_timeout 30s
					tls_insecure_skip_verify
				}
			}
		}
	}
}

# Generated by CaddyHub. Do not edit by hand: changes are made in the panel
# and this file is regenerated on every apply. Export is always available.
{
	admin caddy-admin:2019 {
		origins caddy-admin:2019
	}
	email admin@example.com
	metrics {
		per_host
	}
	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	# raw global options
	servers {
		protocols h1 h2
	}
}

(lan_only) {
	@external not remote_ip private_ranges
	respond @external 403
}

# Common security headers
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# raw block: imported legacy
legacy.example.com:8443 {
	respond "legacy"
}

# site 1: App
app.example.com {
	log {
		output file /var/log/caddy/access-site-1.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
	import security_headers
	import lan_only
	reverse_proxy app:80
	# raw site snippet
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
